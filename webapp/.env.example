# Mémento web: copy to .env next to docker-compose.yml and fill in. Never commit the real file.

# ---- docker-compose ----
# The Mémento folder inside the WebDAV server's data (rclone serve webdav)
MEMENTO_DATA_HOST=/volume1/docker/synchrotron-server/data/Memento
# Local access: http://<NAS address>:8095 ; the Cloudflare tunnel goes to http://memento-web:8080
WEB_PORT=8095
# The identity that may write the folder (see docker-compose.example.yml): 0/0 = the WebDAV server's own
PUID=0
PGID=0

# ---- the app ----
# The web app's own login, required even behind Cloudflare Access. 12 characters at least.
MEMENTO_USER=
MEMENTO_PASSWORD=
# Behind the Cloudflare tunnel: trust CF-Connecting-IP (the visitor's address, for the login throttle) and
# X-Forwarded-Proto (Secure cookie over https). Leave false when nothing sits in front of the container.
MEMENTO_TRUST_PROXY=true
# Optional: only these peers may set those headers (the tunnel's docker network), e.g. 172.16.0.0/12
MEMENTO_TRUSTED_PROXIES=
# auto: Secure cookie when the page came over https (the tunnel), plain cookie over http on the LAN.
# true forces Secure (LAN http logins then fail), false never sets it.
MEMENTO_COOKIE_SECURE=auto
# A session lasts this many days from the login, never extended (1 to 30).
MEMENTO_SESSION_DAYS=7
# Optional: secret signing the session fingerprints. Empty = generated once into /config/secret.
# Changing it, MEMENTO_USER or MEMENTO_PASSWORD closes every session.
MEMENTO_SESSION_SECRET=
# How often the folder is checked for changes made by a sync (seconds)
MEMENTO_POLL_SECONDS=3
