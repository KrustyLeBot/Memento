<?xml version="1.0" encoding="utf-8"?>
<!--
    The account type as the contacts apps read it (AOSP ExternalAccountType + BaseAccountType; Samsung Contacts
    follows it). Any rule broken below makes the whole account type rejected (DefinitionException), so:
    - EditSchema must hold "name" and "photo";
    - "name" must have maxOccurs="1" and ALL of supportsPrefix, supportsMiddleName, supportsSuffix and the three
      supportsPhonetic* set to true (BaseAccountType.NameKindBuilder: "For now, every thing must be supported");
    - "photo" and "note" must have maxOccurs="1"; a kind with a type column needs at least one Type.

    EditSchema: declares the fields a contact of the account may hold, which makes the account writable: the
    phone's contacts app then offers "Mémento" when a contact is created (the "save to" list, default storage)
    and edits its contacts with these fields, those of a Mémento contact (MirrorPlan.rows). The prefix and the
    middle name are read into the first name, the suffix into the last name; the phonetic name and a photo stay
    on the phone (an update keeps them) but are not copied into the files. E-mails and the address carry no
    type in the files, so a single type is offered for them: a type chosen on the phone would not survive.

    inviteContactActivity / inviteContactActionLabel (no namespace, also read by ExternalAccountType): on a
    contact of ANOTHER account the contacts app may offer "Ajouter à Mémento", which starts MainActivity with
    com.android.contacts.action.INVITE_CONTACT and the contact's lookup URI (an import, ContactRequestFlow).
-->
<ContactsAccountType xmlns:android="http://schemas.android.com/apk/res/android"
    inviteContactActivity="app.memento.MainActivity"
    inviteContactActionLabel="@string/invite_contact_label">
    <EditSchema>
        <DataKind
            kind="name"
            maxOccurs="1"
            supportsDisplayName="true"
            supportsPrefix="true"
            supportsMiddleName="true"
            supportsSuffix="true"
            supportsPhoneticFamilyName="true"
            supportsPhoneticMiddleName="true"
            supportsPhoneticGivenName="true" />
        <DataKind kind="photo" maxOccurs="1" />
        <DataKind kind="phone">
            <Type type="mobile" />
            <Type type="home" />
            <Type type="work" />
            <Type type="other" />
            <Type type="custom" />
        </DataKind>
        <DataKind kind="email">
            <Type type="other" />
        </DataKind>
        <DataKind kind="postal" maxOccurs="1" needsStructured="false">
            <Type type="home" />
        </DataKind>
        <DataKind kind="event" maxOccurs="1" dateWithTime="false">
            <Type type="birthday" maxOccurs="1" yearOptional="true" />
        </DataKind>
        <DataKind kind="note" maxOccurs="1" />
    </EditSchema>
</ContactsAccountType>
