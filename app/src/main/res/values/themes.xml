<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
    Compose paints every colour itself. forceDarkAllowed=false keeps One UI's "dark mode for apps" from
    re-darkening a window whose theme says light on top of the app's own dark palette (it darkened the light
    accent fills under their dark labels: black on black). values-night has the dark parent.
    -->
    <style name="Theme.Memento" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>
</resources>
